// The big-bank demo site: a static-assets-only Worker on Cloudflare.
// Build it first from the repo root with `pnpm demo:big-bank`, which writes ./site.
// .github/workflows/sites.yml deploys each PR to a Preview and the beta branch to beta.big-bank.archidocs.dev
// (`--env staging`); .github/workflows/publish.yml deploys production from a stable release tag.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "archidocs-big-bank",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site"
  },
  "routes": [{ "pattern": "big-bank.archidocs.dev", "custom_domain": true }],
  // Production is served only on the custom domain; Previews get workers.dev URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Worker Previews (`wrangler preview`) need this block; an empty one keeps the production settings.
  "previews": {},
  "env": {
    // The demo at the beta branch, ahead of the release: a Worker of its own on beta.big-bank.archidocs.dev.
    "staging": {
      "name": "archidocs-big-bank-staging",
      "assets": {
        "directory": "./site"
      },
      "routes": [{ "pattern": "beta.big-bank.archidocs.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
