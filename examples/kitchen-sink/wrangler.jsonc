// The kitchen-sink demo site: a static-assets-only Worker on Cloudflare.
// Build it first from the repo root with `pnpm demo:kitchen-sink`, which writes ./site.
// .github/workflows/sites.yml deploys each PR to a Preview and the beta branch to beta.kitchen-sink.archidocs.dev
// (`--env staging`); .github/workflows/publish.yml deploys production on every push to main that passes CI.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "archidocs-kitchen-sink",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site"
  },
  "routes": [{ "pattern": "kitchen-sink.archidocs.dev", "custom_domain": true }],
  // Production is served only on the custom domain; Previews get workers.dev URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Worker Previews (`wrangler preview`) need this block; an empty one keeps the production settings.
  "previews": {},
  // Workers Logs: keep request and console logs in the dashboard. Environments inherit it.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "env": {
    // The demo at the beta branch, ahead of the release: a Worker of its own on beta.kitchen-sink.archidocs.dev.
    "staging": {
      "name": "archidocs-kitchen-sink-staging",
      "assets": {
        "directory": "./site"
      },
      "routes": [{ "pattern": "beta.kitchen-sink.archidocs.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
