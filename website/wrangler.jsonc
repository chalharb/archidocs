// The docs site, archidocs.dev: a static-assets-only Worker on Cloudflare.
// Build it first from the repo root with `pnpm docs:build`, which writes ./dist.
// .github/workflows/sites.yml deploys each PR to a Preview and the beta branch to beta.archidocs.dev
// (`--env staging`); .github/workflows/publish.yml deploys production on every push to main that passes CI.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "archidocs-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "archidocs.dev", "custom_domain": true },
    { "pattern": "www.archidocs.dev", "custom_domain": true }
  ],
  // Production is served only on the custom domains; Previews get workers.dev URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Worker Previews (`wrangler preview`) need this block; an empty one keeps the production settings.
  "previews": {},
  "env": {
    // The docs at the beta branch, ahead of the release: a Worker of its own on beta.archidocs.dev.
    "staging": {
      "name": "archidocs-docs-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      },
      "routes": [{ "pattern": "beta.archidocs.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
