---
/**
 * A left-to-right flow drawn from an ordered list in the page, so the
 * Markdown copy of the page still reads as a list:
 *
 *   <Flow>
 *   1. **Project YAML** in git
 *   2. `archidocs check`
 *   </Flow>
 *
 * A step whose list item holds a nested list fans out into those items.
 */
---

<div class="flow not-content">
  <slot />
</div>

<style>
  .flow :global(ol) {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem 2rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    counter-reset: none;
  }
  .flow :global(ol > li) {
    position: relative;
    flex: 1 1 9rem;
    margin: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .flow :global(ol > li:not(:last-child))::after {
    content: "→";
    position: absolute;
    right: -1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-3);
    font-size: 1.1rem;
  }
  .flow :global(ol > li > ul) {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.4rem;
  }
  .flow :global(ol > li > ul > li) {
    margin: 0;
    padding: 0.4rem 0.6rem;
    border-radius: 0.3rem;
    background: var(--sl-color-gray-6);
  }
  @media (max-width: 50rem) {
    .flow :global(ol) {
      flex-direction: column;
    }
    .flow :global(ol > li:not(:last-child))::after {
      content: "↓";
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.35rem;
      transform: translateX(-50%);
    }
  }
</style>
