---
/**
 * A View from an example Workspace, as `archidocs export` renders it at
 * build time: the light and dark pictures, of which CSS shows the one for
 * Starlight's `[data-theme]`, and for a demo a link to the same View in its
 * live viewer. A Workspace that isn't deployed (the quick start's) shows the
 * Generated Views it names in `lib/examples.ts`, with no link.
 *
 *   <Diagram view="big-bank/digital:mainframe-outage" alt="…" />
 *   <Diagram view="quick-start/c2" alt="…" />
 */
import { diagramFile, diagramUrl, exportDiagrams, findDiagramSource, isDemo, liveViewerUrl } from "../lib/examples.ts";

interface Props {
  /** `<example>/<view-id>`: a Saved View, as in `big-bank/digital:mainframe-outage`, or a Generated View, as in `quick-start/c2`. */
  view: string;
  alt: string;
  caption?: string;
}

const { view, alt, caption } = Astro.props;
const slash = view.indexOf("/");
if (slash < 0) throw new Error(`<Diagram view="${view}">: write the view as <example>/<project>:<view-id>.`);
const example = findDiagramSource(view.slice(0, slash));
const viewId = view.slice(slash + 1);
const diagrams = await exportDiagrams();
if (!diagrams.has(`${example.slug}/light/${diagramFile(viewId)}`)) {
  const exported = [...diagrams.keys()].filter((k) => k.startsWith(`${example.slug}/light/`)).map((k) => k.split("/")[2]);
  throw new Error(`<Diagram view="${view}">: ${example.name} has no exported View ${viewId}. Its exported Views: ${exported.join(", ")}.`);
}
const live = isDemo(example) ? liveViewerUrl(example, viewId) : undefined;
---

<figure class="diagram not-content" data-view={view}>
  <img class="diagram-light" src={diagramUrl(example, "light", viewId)} alt={alt} loading="lazy" decoding="async" />
  <img class="diagram-dark" src={diagramUrl(example, "dark", viewId)} alt={alt} loading="lazy" decoding="async" />
  {
    (caption || live) && (
      <figcaption>
        {caption && <span>{live ? `${caption} · ` : caption}</span>}
        {live && <a href={live}>Open in the live viewer ↗</a>}
      </figcaption>
    )
  }
</figure>
