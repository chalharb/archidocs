{
  "title": "Archidocs ADR frontmatter (<project>/adr/NNNN-slug.md)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "The date of the last status change"
    },
    "decision-makers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "People or Team ids; not checked"
    },
    "consulted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "People or Team ids; not checked"
    },
    "informed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "People or Team ids; not checked"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elements": {
      "description": "Elements and Deployment Targets the decision affects",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9-]*:)?[a-z0-9][a-z0-9-]*$",
        "description": "An id in this Project, or `project:id` for one in another Project"
      }
    },
    "views": {
      "description": "Saved Views the decision affects",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9-]*:)?[a-z0-9][a-z0-9-]*$",
        "description": "An id in this Project, or `project:id` for one in another Project"
      }
    },
    "supersedes": {
      "description": "ADRs this one replaces once accepted",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9-]*:)?\\d{4}$",
        "description": "An ADR number in this Project, or `project:NNNN` for one in another Project"
      }
    }
  },
  "required": [
    "status",
    "date"
  ],
  "additionalProperties": false
}
