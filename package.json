{
  "name": "archidocs",
  "version": "1.1.0",
  "description": "Git-native architecture as code: check and bundle a Workspace of Projects.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://archidocs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chalharb/archidocs.git"
  },
  "bugs": {
    "url": "https://github.com/chalharb/archidocs/issues"
  },
  "bin": {
    "archidocs": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "guide",
    "schemas"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:viewer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer && pnpm --dir website check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:catalogue": "node scripts/rule-catalogue.ts",
    "schemas": "node scripts/generate-schemas.ts",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "test:e2e": "playwright test",
    "dev": "pnpm build:viewer && node src/cli/main.ts dev --workspace \"${INIT_CWD:-.}\"",
    "dev:viewer": "vite --config viewer/vite.config.ts",
    "demo:big-bank": "pnpm build:viewer && node examples/big-bank/build-demo.mjs examples/big-bank/site",
    "docs:dev": "pnpm --dir website dev",
    "docs:build": "pnpm --dir website build",
    "docs:test": "pnpm --dir website test",
    "docs:tutorial": "pnpm build:viewer && node website/scripts/tutorial.ts",
    "demo:kitchen-sink": "pnpm build:viewer && cd examples/kitchen-sink && node ../../src/cli/main.ts build --out site"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-wasm": "2.6.2",
    "elkjs": "0.12.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@xyflow/react": "12.12.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "packageManager": "pnpm@10.32.1"
}
