{
  "name": "archidoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project performance",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run --project bench",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@xyflow/react": "12.12.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "elkjs": "0.12.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
