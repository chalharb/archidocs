{
  "name": "archidocs",
  "version": "0.0.0",
  "description": "Git-native architecture as code: check and bundle a Workspace of Projects.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "archidocs": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:viewer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:catalogue": "node scripts/rule-catalogue.ts",
    "schemas": "node scripts/generate-schemas.ts",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "test:e2e": "playwright test",
    "dev:viewer": "vite --config viewer/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-wasm": "2.6.2",
    "elkjs": "0.12.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@xyflow/react": "12.12.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.32.1"
}
